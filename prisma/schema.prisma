generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          Int       @id @default(autoincrement())
  name        String
  category    String
  author      String
  image       String?
  rating      Float     @default(0)
  views       Int       @default(0)
  description String
  duration    Int
  servings    Int
  difficulty  String
  ingredients String[]
  steps       String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  user      String
  text      String
  createdAt DateTime @default(now())
  recipeId  Int
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}